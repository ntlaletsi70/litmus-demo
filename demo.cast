[0.005, "o", "\u001b[39m\u001b[49m\u001b[38;5;214m\u001b[40m\u001b[68D\n\n😗 No resources found for v1/pods in \"litmus-demo\" namespace"]
[2.146, "o", "\r\n\n\u001b[39m\u001b[49m\u001b[K LitmusChaos pod-delete demo\r\n\u001b[K\n\u001b[K What you're about to see: litmus-core (chaos-operator only,\r\n\u001b[K no ChaosCenter/portal), a disposable 3-replica nginx target,\r\n\u001b[K then a ChaosEngine killing ~50% of its pods. Watch the k9s\r\n\u001b[K pane above for pods terminating and Kubernetes rescheduling\r\n\u001b[K replacements before the verdict prints below.\r\n\u001b[K============================================================\r\n\u001b[K== Installing litmus-core operator (no ChaosCenter/portal) ==\r\n\u001b[Knamespace/litmus-demo created\r\n\u001b[K\u001b[11;71H"]
[1.002, "o", "\r\n\n\u001b[K\n\u001b[K What you're about to see: litmus-core (chaos-operator only,\r\n\u001b[K no ChaosCenter/portal), a disposable 3-replica nginx target,\r\n\u001b[K then a ChaosEngine killing ~50% of its pods. Watch the k9s\r\n\u001b[K pane above for pods terminating and Kubernetes rescheduling\r\n\u001b[K replacements before the verdict prints below.\r\n\u001b[K============================================================\r\n\u001b[K== Installing litmus-core operator (no ChaosCenter/portal) ==\r\n\u001b[Knamespace/litmus-demo created\r\n\u001b[KNAME: litmus\r\n\u001b[K\u001b[11;71H"]
[0.000, "o", "\u001b[36m\u001b[39m\u001b[32m\u001b[39m\r\n\n\u001b[K\n\u001b[Kroot@demo:~# kubectl get pods -n litmus\r\n\u001b[KNAME\u001b[22CREADY   STATUS\u001b[4CRESTARTS   AGE\r\n\u001b[Klitmus-7d998b6568-nnlcd   1/1\u001b[5CRunning   0\u001b[10C106s\r\n\u001b[K\n\u001b[K## Start Running Chaos Experiments\r\n\u001b[K----------------------------------\r\n\u001b[KWith this, you are good to go!! Refer to the chaos experiment documentation @ ht\r\n\u001b[K\u001b[20;80Https://docs.litmuschaos.io\r\n\u001b[Kto start executing your first experiment.\r\n\u001b[K\u001b[11;71H"]
[0.104, "o", "\r\n\n\u001b[KNAME\u001b[22CREADY   STATUS\u001b[4CRESTARTS   AGE\r\n\u001b[Klitmus-7d998b6568-nnlcd   1/1\u001b[5CRunning   0\u001b[10C106s\r\n\u001b[K\n\u001b[K## Start Running Chaos Experiments\r\n\u001b[K----------------------------------\r\n\u001b[KWith this, you are good to go!! Refer to the chaos experiment do"]
[0.000, "o", "cumentation @ ht\r\n\u001b[K\u001b[18;80Https://docs.litmuschaos.io\r\n\u001b[Kto start executing your first experiment.\r\n\u001b[KWaiting for deployment \"litmus\" rollout to finish: 0 out of 1 new replicas have \r\n\u001b[K\u001b[21;80H been updated...\r\n\u001b[K\u001b[11;71H"]
[0.386, "o", "\r\n\n\u001b[K\n\u001b[K## Start Running Chaos Experiments\r\n\u001b[K----------------------------------\r\n\u001b[KWith this, you are good to go!! Refer to the chaos experiment documentation @ ht\r\n\u001b[K\u001b[16;80Https://docs.litmuschaos.io\r\n\u001b[Kto start executing your first experiment.\r\n\u001b[KWaiting for deployment \"litmus\" rollout to finish: 0 out of 1 new replicas have \r\n\u001b[K\u001b[19;80H been updated...\r\n\u001b[KWaiting for deployment \"litmus\" rollout to finish: 0 of 1 updated replicas are a\r\n\u001b[K\u001b[21;80Havailable...\r\n\u001b[K\u001b[11;71H"]
